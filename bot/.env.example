# Discord application (discord.com/developers). The bot is read-only: it never holds Solana keys.
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
# Guild (server) where npm run register installs the slash commands.
DISCORD_GUILD_ID=
# Channel where new and settled pots are announced.
DISCORD_CHANNEL_ID=

# Solana RPC used for all reads. Devnet by default.
SOLANA_RPC_URL=https://api.devnet.solana.com
# Where the web app runs; pot links are built from it exactly like the app's Share button.
APP_URL=http://localhost:3000
# How often to read the pots, in milliseconds (minimum 5000).
POLL_INTERVAL_MS=30000
# Set to 1 to print the messages the bot would post instead of connecting to Discord.
DRY_RUN=
