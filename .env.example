# Public RPC endpoint used by the browser. Never put a private key here.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
# Create an app in Privy to enable passwordless email/Google login and automatic embedded wallets.
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_SOLANA_NETWORK=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_WS_URL=wss://api.devnet.solana.com

# Optional server-only fallback when the public devnet faucet is busy.
# Point this at a funded devnet keypair; never use a mainnet keypair.
SOLARA_DEMO_FUNDER_KEYPAIR=.wallets/deployer.json
