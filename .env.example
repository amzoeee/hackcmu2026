# Public devnet connection. Never put a private key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SOLANA_NETWORK=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_WS_URL=wss://api.devnet.solana.com

# Optional Privy app for email/Google login and embedded wallets.
NEXT_PUBLIC_PRIVY_APP_ID=

# Optional server-only fallback when the public devnet faucet is busy.
# Example: .wallets/deployer.json after funding that devnet wallet.
# Leave blank to use the public faucet. Never use a mainnet keypair.
SOLARA_DEMO_FUNDER_KEYPAIR=
